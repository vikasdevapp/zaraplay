PORT=4000
DATABASE_URL="postgresql://rewardsplay:rewardsplay@localhost:5432/rewardsplay?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# GGUSOnePay payment gateway. Deposits go through the gateway when MCH_NO, API_KEY and
# API_PUBLIC_URL are all set; otherwise deposits fall back to manual admin approval.
# Payouts go through it when GGUSONEPAY_TRANSFER_WAY_CODES is also set.
GGUSONEPAY_BASE_URL="https://www.ggusonepay.com"
GGUSONEPAY_MCH_NO=""
GGUSONEPAY_API_KEY=""
GGUSONEPAY_CURRENCY="usd"
# Deposit methods offered to users (first is the default): cashapp, ecashapp, zelle, btcpay, paypal, applepay, googlepay, card, chime
GGUSONEPAY_PAY_WAY_CODES="cashapp"
# Payout methods offered to users: card (debit card; needs PAYOUT_ENCRYPTION_KEY), ecashapp ($Cashtag), chime ($ChimeSign), paypal, venmo, zelle. Empty = payouts stay manual.
GGUSONEPAY_TRANSFER_WAY_CODES="card,ecashapp,chime"
# Gateway's callback IP(s); callbacks from other IPs are refused. Empty disables the check.
GGUSONEPAY_NOTIFY_IPS="52.9.62.200"
# Test merchants only: "success" or "fail" makes the gateway auto-callback ~1 min after each order. Leave empty in production.
GGUSONEPAY_SANDBOX_AUTO_RESULT=""
# Unpaid deposit orders expire after this many seconds (1800-86400); expired ones are closed automatically.
GGUSONEPAY_ORDER_EXPIRE_SECONDS=1800
# Public base URLs: notifyUrl = API_PUBLIC_URL/api/payments/ggusonepay/notify/{pay,transfer}; returnUrl = WEB_PUBLIC_URL/wallet
API_PUBLIC_URL=""
WEB_PUBLIC_URL="http://localhost:3000"

# Encrypts card numbers for card payouts (64 hex chars; generate with: openssl rand -hex 32).
# Keep it secret and stable - changing it makes pending card payouts unreadable. Card payouts are hidden while unset.
PAYOUT_ENCRYPTION_KEY=""
