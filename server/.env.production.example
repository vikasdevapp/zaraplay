# Copy this to server/.env on the EC2 host (NOT committed to git) and fill in real values.
# docker-compose.prod.yml loads this file for both the postgres and api services, so
# POSTGRES_USER/PASSWORD/DB and DATABASE_URL must describe the same database.

PORT=4000

POSTGRES_USER=zaraplays
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=zaraplays
# Host is "postgres" (the docker-compose service name), not localhost — containers reach
# each other by service name on the compose network.
DATABASE_URL="postgresql://zaraplays:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/zaraplays?schema=public"

REDIS_URL="redis://redis:6379"

# Generate with: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# Origin(s) the API accepts requests from. Bare IP for now; once subdomains exist, list
# them all, comma-separated (server/src/index.ts splits on ",").
CORS_ORIGIN="http://75.101.203.116"

# Twilio (SMS phone verification + SMS broadcasts). Without these, phone verification still
# works end-to-end but the OTP is logged server-side instead of texted (see lib/sms.ts).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Web Push (browser notifications). Generate once with: npx web-push generate-vapid-keys
# Reuse the SAME keypair across restarts/deploys — rotating it invalidates every existing
# subscription and users would need to re-enable notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@zaraplays.local"

# GGUSOnePay payment gateway. Deposits go through the gateway when MCH_NO, API_KEY and
# API_PUBLIC_URL are all set; otherwise deposits fall back to manual admin approval.
# Payouts go through it when GGUSONEPAY_TRANSFER_WAY_CODES is also set.
GGUSONEPAY_BASE_URL="https://www.ggusonepay.com"
GGUSONEPAY_MCH_NO=""
GGUSONEPAY_API_KEY=""
GGUSONEPAY_CURRENCY="usd"
# Deposit methods offered to users (first is the default): cashapp, ecashapp, zelle, btcpay, paypal, applepay, googlepay, card, chime
GGUSONEPAY_PAY_WAY_CODES="cashapp"
# Payout methods offered to users; supported: ecashapp, paypal, venmo, zelle, chime. Empty = payouts stay manual.
GGUSONEPAY_TRANSFER_WAY_CODES=""
# Gateway's callback IP(s); callbacks from other IPs are refused. Empty disables the check.
GGUSONEPAY_NOTIFY_IPS="52.9.62.200"
# Test merchants only: "success" or "fail" makes the gateway auto-callback ~1 min after each order. Leave empty in production.
GGUSONEPAY_SANDBOX_AUTO_RESULT=""
# Unpaid deposit orders expire after this many seconds (1800-86400); expired ones are closed automatically.
GGUSONEPAY_ORDER_EXPIRE_SECONDS=1800
# Public base URLs: notifyUrl = API_PUBLIC_URL/api/payments/ggusonepay/notify/{pay,transfer}; returnUrl = WEB_PUBLIC_URL/wallet
API_PUBLIC_URL="http://75.101.203.116"
WEB_PUBLIC_URL="http://75.101.203.116"
