generator client {
  provider      = "prisma-client-js"
  // omitApi: lets lib/prisma.ts hide Transaction.payoutSecret from every query by default.
  previewFeatures = ["omitApi"]
  // "native" covers local dev (Windows/Mac/glibc Linux); the musl target is needed for the
  // Alpine-based production Docker image, which ships OpenSSL 3.x, not the 1.1.x Prisma
  // defaults to on musl without this.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  ADMIN
  MASTER_ADMIN
}

enum TransactionType {
  DEPOSIT
  CASHOUT
  SIGNUP_BONUS
  REFERRAL_BONUS
  DEPOSIT_BONUS
  WEEKEND_BONUS
  FREEPLAY_GRANT
  ADMIN_ADJUSTMENT
  MARKETPLACE_REDEMPTION
  ROULETTE_WIN
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum BroadcastChannel {
  SMS
  EMAIL
  PUSH
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  username      String   @unique
  email         String   @unique
  passwordHash  String
  phone         String?
  phoneVerified Boolean  @default(false)
  role          Role     @default(USER)
  avatarUrl     String?

  referralCode  String   @unique
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]   @relation("Referrals")

  signupIp      String
  createdAt     DateTime @default(now())

  wallet        Wallet?
  games         UserGame[]
  transactions  Transaction[]
  chatMessages  ChatMessage[]
  auditLogs     AuditLog[]
  rouletteSpins RouletteSpin[]
  pushSubscriptions PushSubscription[]
  payoutMethods PayoutMethod[]
}

model Wallet {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  balance             Decimal  @default(0) @db.Decimal(12, 2)
  freePlay            Decimal  @default(0) @db.Decimal(12, 2)
  totalDeposited      Decimal  @default(0) @db.Decimal(12, 2)
  lastDepositAmount   Decimal  @default(0) @db.Decimal(12, 2)
  hasDeposited        Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Transaction {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  type            TransactionType
  amount          Decimal            @db.Decimal(12, 2)
  status          TransactionStatus  @default(COMPLETED)
  // CASHOUT only: the tier-capped amount actually payable, and the amount forfeited above the cap.
  payoutAmount    Decimal?           @db.Decimal(12, 2)
  forfeitedAmount Decimal?           @db.Decimal(12, 2)
  adminNote       String?
  meta            Json?
  // Set when the transaction is handed to a payment gateway (claimed atomically, so a
  // cashout can't be submitted for payout twice); gatewayOrderNo is the gateway's own id.
  gatewayProvider String?
  gatewayOrderNo  String?
  // CASHOUT to card only: the card number, AES-GCM sealed (lib/secretBox). Never returned by
  // the API, and wiped once the payout is handed to the gateway or the request is rejected.
  payoutSecret    String?
  createdAt       DateTime           @default(now())

  @@index([gatewayProvider, status])
}

// Raw record of every payment gateway callback (accepted or not), kept for disputes and
// debugging missed/duplicate notifications.
model GatewayEvent {
  id             String   @id @default(cuid())
  provider       String
  kind           String
  mchOrderNo     String?
  ip             String?
  signatureValid Boolean
  payload        Json
  result         String
  createdAt      DateTime @default(now())

  @@index([mchOrderNo])
}

model Game {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  // Link opened by the "Play Now" button on the customer Games page.
  playUrl   String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  userGames UserGame[]
}

model UserGame {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id])
  gameUsername String
  gamePassword String
  balance      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@unique([userId, gameId])
}

model SupportAgent {
  id           String        @id @default(cuid())
  name         String
  isOnline     Boolean       @default(true)
  chatMessages ChatMessage[]
}

model ChatMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  agentId   String
  agent     SupportAgent  @relation(fields: [agentId], references: [id])
  sender    String // "USER" | "AGENT"
  body      String
  createdAt DateTime      @default(now())
}

model BroadcastMessage {
  id             String           @id @default(cuid())
  channel        BroadcastChannel
  subject        String?
  body           String
  recipientCount Int
  createdAt      DateTime         @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())
}

model VipTier {
  id           String   @id @default(cuid())
  name         String
  emoji        String   @default("⭐")
  colorHex     String   @default("#D4AF37")
  minDeposit   Decimal  @default(0) @db.Decimal(12, 2)
  minReferrals Int      @default(0)
  perks        String[]
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model MarketplaceItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("Starter")
  fpCost    Decimal  @db.Decimal(12, 2)
  cashValue Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Singleton row (id is always "default") holding the operator-configurable business rules
// that used to be hardcoded constants — surfaced in the admin panel as "Platform Rules" /
// "IP Security".
model PlatformSettings {
  id                        String   @id @default("default")
  minDeposit                Decimal  @default(10) @db.Decimal(12, 2)
  maxDeposit                Decimal  @default(10000) @db.Decimal(12, 2)
  minWithdrawal             Decimal  @default(20) @db.Decimal(12, 2)
  maxWithdrawal             Decimal  @default(5000) @db.Decimal(12, 2)
  signupBonusPercent        Decimal  @default(100) @db.Decimal(6, 2)
  weekendBonusPercent       Decimal  @default(50) @db.Decimal(6, 2)
  regularBonusPercent       Decimal  @default(20) @db.Decimal(6, 2)
  referralBonusPercent      Decimal  @default(100) @db.Decimal(6, 2)
  freeplaySignupGrant       Decimal  @default(5) @db.Decimal(12, 2)
  phoneVerifyBonus          Decimal  @default(5) @db.Decimal(12, 2)
  freeplayCashoutCap        Decimal  @default(20) @db.Decimal(12, 2)
  cashoutTierBoundary       Decimal  @default(35) @db.Decimal(12, 2)
  cashoutTier1MinMultiplier Decimal  @default(5) @db.Decimal(6, 2)
  cashoutTier1MaxMultiplier Decimal  @default(10) @db.Decimal(6, 2)
  cashoutTier2MinMultiplier Decimal  @default(3) @db.Decimal(6, 2)
  ipSignupMaxPerDay         Int      @default(2)
  ipBlockMessage            String   @default("Only {max} accounts can be created per device/network each day. Please try again tomorrow.")
  updatedAt                 DateTime @updatedAt
}

model RoulettePrize {
  id        String   @id @default(cuid())
  label     String
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  // Relative probability weight — a prize with weight 40 is 4x as likely as one with weight 10.
  weight    Int      @default(1)
  colorHex  String   @default("#8b5cf6")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RouletteSpin {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  prizeLabel String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
}

// Saved withdrawal destinations. A cashout copies the chosen one onto its transaction
// (meta.payout + payoutSecret), so editing or deleting a method never changes a pending request.
model PayoutMethod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  wayCode   String
  // Display-safe: the handle itself ($Cashtag, email…), or "•••• 1234" for cards.
  account   String
  // Card only: expiry as MM/YYYY and the AES-GCM sealed card number (lib/secretBox), never
  // returned by the API.
  cardValid String?
  secret    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
