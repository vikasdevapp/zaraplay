generator client {
  provider      = "prisma-client-js"
  // omitApi: lets lib/prisma.ts hide Transaction.payoutSecret from every query by default.
  previewFeatures = ["omitApi"]
  // "native" covers local dev (Windows/Mac/glibc Linux); the musl target is needed for the
  // Alpine-based production Docker image, which ships OpenSSL 3.x, not the 1.1.x Prisma
  // defaults to on musl without this.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  SUPPORT
  ADMIN
  MASTER_ADMIN
}

enum TransactionType {
  DEPOSIT
  CASHOUT
  SIGNUP_BONUS
  REFERRAL_BONUS
  DEPOSIT_BONUS
  WEEKEND_BONUS
  FREEPLAY_GRANT
  ADMIN_ADJUSTMENT
  MARKETPLACE_REDEMPTION
  ROULETTE_WIN
  // Wallet -> game credits (debited when requested, refunded if the agent rejects it).
  GAME_RECHARGE
  // Game credits -> wallet (credited when the agent confirms the redeem).
  GAME_REDEEM
}

enum GameAccountStatus {
  // Waiting for an agent to create the account on the game's own platform.
  PENDING
  ACTIVE
  // Account creation was rejected; the player can request it again.
  REJECTED
}

enum GameRequestType {
  CREATE_ACCOUNT
  RECHARGE
  REDEEM
  PASSWORD_RESET
  // Player asks for their recorded balance to be re-read from the game platform.
  BALANCE_CHECK
}

enum GameRequestStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

// Agent Desk credit ledger (mirrors the game distributor panel's Recharge / Bonus / Redeem / Free Play).
// Game platforms we can drive automatically via their agent API. null = fully manual (agents).
enum GameAutomationProvider {
  JUWA
  GAMEVAULT
  JUWA2
  CASHFRENZY
}

// Admin-managed, encrypted credentials for a game platform's agent API, so the operator can set
// or change them from the panel (no server/.env access, no sharing). One row per provider.
model PlatformCredential {
  id             String   @id @default(cuid())
  // Matches a GameAutomationProvider value (e.g. "JUWA", "CASHFRENZY").
  provider       String   @unique
  baseUrl        String   @default("")
  // Agent ID (Juwa-style) OR agent username (Cash Frenzy-style).
  agentId        String   @default("")
  // AES-GCM sealed (lib/secretBox): secret key (Juwa-style) OR password (Cash Frenzy-style).
  secret         String   @default("")
  balanceDivisor Decimal  @default(1) @db.Decimal(14, 4)
  updatedAt      DateTime @updatedAt
}

enum GameTxType {
  RECHARGE
  BONUS
  REDEEM
  FREEPLAY
}

// PAGE / PERSONAL: the player paid the agent outside this site (social page or the agent
// personally), so the wallet is untouched. WEB: done through the website (wallet-funded).
enum GameTxSource {
  PAGE
  PERSONAL
  WEB
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum BroadcastChannel {
  SMS
  EMAIL
  PUSH
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  username      String   @unique
  email         String   @unique
  passwordHash  String
  phone         String?
  phoneVerified Boolean  @default(false)
  // Set from the unsubscribe link in broadcast emails; OTP and account emails still go out.
  emailOptOut   Boolean  @default(false)
  // Staff two-factor (TOTP, RFC 6238). Secret is base32; only set once the user confirms a code.
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  role          Role     @default(USER)
  avatarUrl     String?
  // Moderation: when set the account is blocked (can't sign in); reason is shown to the player.
  blockedAt     DateTime?
  blockedReason String?

  referralCode  String   @unique
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]   @relation("Referrals")

  signupIp      String
  createdAt     DateTime @default(now())

  wallet        Wallet?
  games         UserGame[]
  gameRequests  GameRequest[] @relation("GameRequestPlayer")
  claimedGameRequests GameRequest[] @relation("GameRequestClaimer")
  handledGameRequests GameRequest[] @relation("GameRequestHandler")
  syncedGameBalances  UserGame[]    @relation("GameBalanceSyncer")
  createdGameAccounts UserGame[]    @relation("GameAccountCreator")
  gameTransactions    GameTransaction[] @relation("GameTxStaff")
  backendTopUps       BackendTopUp[]
  transactions  Transaction[]
  chatMessages  ChatMessage[] @relation("UserChats")
  supportReplies ChatMessage[] @relation("SupportReplies")
  supportTickets SupportTicket[] @relation("UserTickets")
  resolvedTickets SupportTicket[] @relation("TicketResolver")
  auditLogs     AuditLog[]
  rouletteSpins RouletteSpin[]
  pushSubscriptions PushSubscription[]
  payoutMethods PayoutMethod[]
  notifications Notification[]

  // Per-game staff hierarchy. An AGENT owns games (Game.agentId -> managedGames). A support
  // staff member is created by that agent (managerId -> manager) and scoped to one of the
  // agent's games (staffGameId -> staffGame). Admins see everyone.
  managedGames  Game[]  @relation("GameAgent")
  managerId     String?
  manager       User?   @relation("StaffManager", fields: [managerId], references: [id])
  staff         User[]  @relation("StaffManager")
  staffGameId   String?
  staffGame     Game?   @relation("GameStaff", fields: [staffGameId], references: [id])

  @@index([managerId])
  @@index([staffGameId])
}

// An in-app alert in the bell menu. Created alongside the web-push notify (lib/webpush
// notifyUser), so the bell and the push stay in step. `link` is an in-app path to open on tap.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  // GAME | WALLET | SUPPORT | SYSTEM — picks the icon and grouping in the bell menu.
  kind      String    @default("SYSTEM")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Wallet {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  balance             Decimal  @default(0) @db.Decimal(12, 2)
  // The portion of `balance` that has been played through a game (came back via Withdraw
  // Credits) and is therefore directly cashable to a bank. Deposits/bonuses are NOT withdrawable
  // until loaded into a game and redeemed; invariant: 0 <= withdrawable <= balance.
  withdrawable        Decimal  @default(0) @db.Decimal(12, 2)
  // Legacy promo bucket, retired with the Free Play system — kept at 0, no longer credited/spent.
  freePlay            Decimal  @default(0) @db.Decimal(12, 2)
  totalDeposited      Decimal  @default(0) @db.Decimal(12, 2)
  lastDepositAmount   Decimal  @default(0) @db.Decimal(12, 2)
  hasDeposited        Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Transaction {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  type            TransactionType
  amount          Decimal            @db.Decimal(12, 2)
  status          TransactionStatus  @default(COMPLETED)
  // CASHOUT only: the tier-capped amount actually payable, and the amount forfeited above the cap.
  payoutAmount    Decimal?           @db.Decimal(12, 2)
  forfeitedAmount Decimal?           @db.Decimal(12, 2)
  adminNote       String?
  meta            Json?
  // Set when the transaction is handed to a payment gateway (claimed atomically, so a
  // cashout can't be submitted for payout twice); gatewayOrderNo is the gateway's own id.
  gatewayProvider String?
  gatewayOrderNo  String?
  // CASHOUT to card only: the card number, AES-GCM sealed (lib/secretBox). Never returned by
  // the API, and wiped once the payout is handed to the gateway or the request is rejected.
  payoutSecret    String?
  createdAt       DateTime           @default(now())

  @@index([gatewayProvider, status])
}

// Raw record of every payment gateway callback (accepted or not), kept for disputes and
// debugging missed/duplicate notifications.
model GatewayEvent {
  id             String   @id @default(cuid())
  provider       String
  kind           String
  mchOrderNo     String?
  ip             String?
  signatureValid Boolean
  payload        Json
  result         String
  createdAt      DateTime @default(now())

  @@index([mchOrderNo])
}

model Game {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  // Link opened by the "Play Now" button on the customer Games page.
  playUrl   String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  // Credits left on our distributor backend for this game, kept by agents: loads and bonuses
  // take from it, redeems return to it, top-ups add to it, and a manual update corrects it.
  backendBalance   Decimal   @default(0) @db.Decimal(14, 2)
  // Dashboard warns when backendBalance falls to or below this (0 = no warning).
  backendLowAt     Decimal   @default(0) @db.Decimal(14, 2)
  backendUpdatedAt DateTime?
  // When set, player actions (create account, load, reset, balance) run through the platform
  // API instead of the agent queue; failures fall back to a manual agent request.
  automationProvider GameAutomationProvider?
  // Short code used when auto-generating usernames (e.g. "jw" for Juwa): name + digit + code + digits.
  shortCode String?
  // This game's own support contact: players open a chat with this agent from the game card,
  // so each game can be supported by its own person (like each game has its own agent).
  supportAgentId String?
  supportAgent   SupportAgent? @relation(fields: [supportAgentId], references: [id])
  // The staff agent (User, role AGENT) who owns this game and watches everything on it.
  agentId   String?
  agent     User?      @relation("GameAgent", fields: [agentId], references: [id])
  // Support staff scoped to this game (created by its agent).
  staff     User[]     @relation("GameStaff")
  userGames UserGame[]
  transactions GameTransaction[]
  topUps       BackendTopUp[]
  chatMessages ChatMessage[]
  supportTickets SupportTicket[]

  @@index([agentId])
}

// A player's account on a third-party game platform. Agents create the real account there
// and enter its credentials here; the balance is our record of the credits in that account,
// moved by recharges/redeems and re-synced by agents from the game's own back office.
model UserGame {
  id              String            @id @default(cuid())
  // Null for accounts an agent created for a player who isn't registered on the website.
  userId          String?
  user            User?             @relation(fields: [userId], references: [id])
  // Agent-entered name for unregistered players (e.g. their social profile name).
  playerName      String?
  createdById     String?
  createdBy       User?             @relation("GameAccountCreator", fields: [createdById], references: [id])
  gameId          String
  game            Game              @relation(fields: [gameId], references: [id])
  status          GameAccountStatus @default(ACTIVE)
  // Null until an agent has created the account on the game platform.
  gameUsername    String?
  gamePassword    String?
  balance         Decimal           @default(0) @db.Decimal(12, 2)
  // Cashout tier basis for the active load: loadDeposit (the recharge amount) picks the tier
  // boundary; loadTotal (deposit + bonus) is what the min/max multipliers apply to. Reset to
  // the leftover after a withdrawal.
  loadDeposit     Decimal           @default(0) @db.Decimal(12, 2)
  loadTotal       Decimal           @default(0) @db.Decimal(12, 2)
  balanceSyncedAt DateTime?
  // The platform player id returned by the automation API (recharge/withdraw/balance use it).
  gameUserId      String?
  balanceSyncedById String?
  balanceSyncedBy User?             @relation("GameBalanceSyncer", fields: [balanceSyncedById], references: [id])
  createdAt       DateTime          @default(now())
  requests        GameRequest[]
  transactions    GameTransaction[]

  @@unique([userId, gameId])
  // A login exists once per game platform.
  @@unique([gameId, gameUsername])
}

// The agents' work queue: every change to a game account goes through one of these.
model GameRequest {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation("GameRequestPlayer", fields: [userId], references: [id])
  userGameId     String
  userGame       UserGame          @relation(fields: [userGameId], references: [id])
  type           GameRequestType
  status         GameRequestStatus @default(PENDING)
  // RECHARGE / CREATE_ACCOUNT: credits to load (already taken from the wallet).
  // REDEEM: credits the player asked for; completedAmount is what the agent actually redeemed.
  amount         Decimal           @default(0) @db.Decimal(12, 2)
  completedAmount Decimal?         @db.Decimal(12, 2)
  // For a load funded by a deposit-and-load: the deposit amount (loadTotal basis = amount).
  loadDeposit     Decimal?         @db.Decimal(12, 2)
  // The wallet ledger row this request moves money through (GAME_RECHARGE / GAME_REDEEM).
  transactionId  String?           @unique
  // An agent claims a request before working it, so two agents never load the same credits.
  claimedById    String?
  claimedBy      User?             @relation("GameRequestClaimer", fields: [claimedById], references: [id])
  claimedAt      DateTime?
  handledById    String?
  handledBy      User?             @relation("GameRequestHandler", fields: [handledById], references: [id])
  agentNote      String?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([userGameId, status])
}

model SupportAgent {
  id           String        @id @default(cuid())
  name         String
  isOnline     Boolean       @default(true)
  chatMessages ChatMessage[]
  // Games this person is the dedicated support contact for.
  games        Game[]
}

model ChatMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("UserChats", fields: [userId], references: [id])
  // Support is per game: a thread is (player, game), handled by the game's agent and their staff.
  gameId    String?
  game      Game?         @relation(fields: [gameId], references: [id])
  // The ticket this message belongs to (a game thread can have several tickets over time).
  ticketId  String?
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id])
  // Legacy persona link (pre per-game support); kept nullable for old rows.
  agentId   String?
  agent     SupportAgent? @relation(fields: [agentId], references: [id])
  sender    String // "USER" | "AGENT"
  // Staff account that typed an AGENT reply (null for user messages and pre-tracking replies).
  sentById  String?
  sentBy    User?         @relation("SupportReplies", fields: [sentById], references: [id])
  body      String        @default("")
  // Optional image attachment (proof photos); site-relative /uploads/chat/... path.
  imageUrl  String?
  createdAt DateTime      @default(now())

  @@index([sentById, createdAt])
  @@index([gameId, userId, createdAt])
  @@index([ticketId, createdAt])
}

// A support ticket: one conversation about a game. NEW = user is waiting for a reply,
// PENDING = staff replied / in progress, SOLVED = resolved (cleared from the user's view).
enum SupportTicketStatus {
  NEW
  PENDING
  SOLVED
}

model SupportTicket {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation("UserTickets", fields: [userId], references: [id])
  gameId          String?
  game            Game?               @relation(fields: [gameId], references: [id])
  status          SupportTicketStatus @default(NEW)
  // Unread user messages for staff: bumped when the user sends, reset to 0 when staff open it.
  staffUnread     Int                 @default(0)
  // When staff last opened this ticket.
  staffLastReadAt DateTime?
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?               @relation("TicketResolver", fields: [resolvedById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  messages        ChatMessage[]

  @@index([gameId, status, updatedAt])
  @@index([userId, status])
}

model BroadcastMessage {
  id             String           @id @default(cuid())
  channel        BroadcastChannel
  subject        String?
  body           String
  recipientCount Int
  // Email broadcasts send in the background; these count up as each message is attempted.
  deliveredCount Int              @default(0)
  failedCount    Int              @default(0)
  createdAt      DateTime         @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())
}

model VipTier {
  id           String   @id @default(cuid())
  name         String
  emoji        String   @default("⭐")
  colorHex     String   @default("#D4AF37")
  minDeposit   Decimal  @default(0) @db.Decimal(12, 2)
  minReferrals Int      @default(0)
  perks        String[]
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model MarketplaceItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("Starter")
  fpCost    Decimal  @db.Decimal(12, 2)
  cashValue Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Singleton row (id is always "default") holding the operator-configurable business rules
// that used to be hardcoded constants — surfaced in the admin panel as "Platform Rules" /
// "IP Security".
model PlatformSettings {
  id                        String   @id @default("default")
  minDeposit                Decimal  @default(9.99) @db.Decimal(12, 2)
  maxDeposit                Decimal  @default(10000) @db.Decimal(12, 2)
  minWithdrawal             Decimal  @default(5) @db.Decimal(12, 2)
  maxWithdrawal             Decimal  @default(5000) @db.Decimal(12, 2)
  signupBonusPercent        Decimal  @default(100) @db.Decimal(6, 2)
  weekendBonusPercent       Decimal  @default(50) @db.Decimal(6, 2)
  regularBonusPercent       Decimal  @default(20) @db.Decimal(6, 2)
  referralBonusPercent      Decimal  @default(100) @db.Decimal(6, 2)
  freeplaySignupGrant       Decimal  @default(5) @db.Decimal(12, 2)
  phoneVerifyBonus          Decimal  @default(5) @db.Decimal(12, 2)
  freeplayCashoutCap        Decimal  @default(20) @db.Decimal(12, 2)
  cashoutTierBoundary       Decimal  @default(35) @db.Decimal(12, 2)
  cashoutTier1MinMultiplier Decimal  @default(5) @db.Decimal(6, 2)
  cashoutTier1MaxMultiplier Decimal  @default(10) @db.Decimal(6, 2)
  cashoutTier2MinMultiplier Decimal  @default(3) @db.Decimal(6, 2)
  ipSignupMaxPerDay         Int      @default(2)
  ipBlockMessage            String   @default("Only {max} accounts can be created per device/network. Please contact support if you need help.")
  updatedAt                 DateTime @updatedAt
}

model RoulettePrize {
  id        String   @id @default(cuid())
  label     String
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  // Relative probability weight — a prize with weight 40 is 4x as likely as one with weight 10.
  weight    Int      @default(1)
  colorHex  String   @default("#8b5cf6")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RouletteSpin {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  prizeLabel String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
}

// Saved withdrawal destinations. A cashout copies the chosen one onto its transaction
// (meta.payout + payoutSecret), so editing or deleting a method never changes a pending request.
model PayoutMethod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  wayCode   String
  // Display-safe: the handle itself ($Cashtag, email…), or "•••• 1234" for cards.
  account   String
  // Card only: expiry as MM/YYYY and the AES-GCM sealed card number (lib/secretBox), never
  // returned by the API.
  cardValid String?
  secret    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// One credit movement on a game account, by an agent (PAGE / PERSONAL) or from the website (WEB).
model GameTransaction {
  id            String        @id @default(cuid())
  type          GameTxType
  source        GameTxSource
  gameId        String
  game          Game          @relation(fields: [gameId], references: [id])
  userGameId    String
  userGame      UserGame      @relation(fields: [userGameId], references: [id])
  // Snapshots, so the ledger reads right even if the login is later corrected.
  gameUsername  String
  amount        Decimal       @db.Decimal(12, 2)
  // Recorded game balance after this movement.
  balanceAfter  Decimal       @db.Decimal(12, 2)
  staffId       String?
  staff         User?         @relation("GameTxStaff", fields: [staffId], references: [id])
  // WEB rows: the website request they came from.
  gameRequestId String?
  note          String?
  createdAt     DateTime      @default(now())

  @@index([type, createdAt])
  @@index([gameId, createdAt])
  @@index([staffId, createdAt])
  @@index([userGameId, createdAt])
}

// Credits bought for a game's distributor backend (manual counterpart of "auto recharge").
model BackendTopUp {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  // Backend balance right after the top-up.
  balanceAfter Decimal @db.Decimal(14, 2)
  note      String?
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}
